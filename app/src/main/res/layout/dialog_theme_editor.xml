<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_editor_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Live Preview Box -->
    <LinearLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Предпросмотр темы"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:lineSpacingExtra="3dp"
            android:text="Чтение хороших книг — это разговор с самыми лучшими людьми прошедших времен, и притом такой разговор, когда они открывают нам только лучшие свои мысли."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Theme presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Встроенные темы"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presetObsidian"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Obsidian"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetGraphite"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Graphite"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetWarmGray"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Warm Gray"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetOled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="OLED Black"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetPaper"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Paper"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Custom Theme Name -->
    <EditText
        android:id="@+id/etCustomThemeName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Название пользовательской темы"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <!-- Color customizers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPickBg"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill_inactive"
            android:gravity="center"
            android:text="Цвет фона"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickText"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill_inactive"
            android:gravity="center"
            android:text="Цвет текста"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnResetTheme"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill_inactive"
            android:gravity="center"
            android:text="@string/theme_reset"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTheme"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/glass_surface_2"
        android:text="@string/theme_save"
        android:textColor="@color/white"
        android:textSize="14sp" />

</LinearLayout>
